{
  "name": "feeds-shijia-work",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "validate:sources": "node scripts/validate-sources.mjs",
    "validate:data": "node scripts/validate-briefings.mjs",
    "validate": "npm run validate:sources && npm run validate:data",
    "sources:sql": "node scripts/sources-to-sql.mjs",
    "briefing:sql": "node scripts/briefing-to-sql.mjs",
    "dev:pages": "npm run build && wrangler pages dev dist",
    "db:create": "wrangler d1 create feeds-shijia",
    "db:migrate:local": "wrangler d1 migrations apply feeds-shijia --local",
    "db:migrate:remote": "wrangler d1 migrations apply feeds-shijia --remote"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260918.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.0.3",
    "wrangler": "^4.37.1",
    "yaml": "^2.8.1"
  }
}
